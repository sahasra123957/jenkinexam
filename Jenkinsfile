pipeline {
    agent any

    stages {
        stage('Clone') {
            steps {
                echo 'Source code cloned successfully'
            }
        }

        stage('Build') {
            steps {
                echo 'Building the application'
            }
            }
        stage('Test') {
            steps {
                echo 'Testing the application'
            }
        }

        stage('Deploy') {
            steps {
                echo 'Deploying the application'
            }
        }
    }
}